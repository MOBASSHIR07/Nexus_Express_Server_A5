# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_express?schema=public"

# Better-Auth Configuration
# Run `openssl rand -hex 32` to generate a secret
BETTER_AUTH_SECRET="your_32_character_hex_secret"
BETTER_AUTH_URL="http://localhost:3000"

# OpenID Connect / OAuth (Optional - for Google/Github login)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Frontend Configuration
FRONTEND_URL="http://localhost:5000"
TRUSTED_AUTH_URL="http://localhost:5000"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Configuration (Nodemailer)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-specific-password"

# Optional Cloudinary (If used for images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
